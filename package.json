{
  "name": "lrobotform-resume",
  "version": "1.0.1",
  "description": "A privacy-aware, quality-gated dual-PDF resume generation pipeline.",
  "author": "LAI ZEYU (https://github.com/lzy2767865503-pixel)",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "check:runner": "python3 -m py_compile aws-runner/resume_runner.py",
    "test:worker": "node --test tests/worker.test.js",
    "test:runner": "python3 -m unittest discover -s aws-runner/tests -v",
    "test:migration": "wrangler d1 execute lrobotform-resume --local --file=migrations/0001_resume_schema.sql",
    "db:migrate:local": "wrangler d1 execute lrobotform-resume --local --file=migrations/0001_resume_schema.sql",
    "db:migrate:remote": "wrangler d1 execute lrobotform-resume --remote --file=migrations/0001_resume_schema.sql",
    "test": "npm run check && npm run check:runner && npm run test:worker && npm run test:runner && npm run test:migration"
  },
  "devDependencies": {
    "wrangler": "^4.100.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2"
}
